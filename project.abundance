        {
          "atomType": "Code",
          "x": 0.7643229166666667,
          "y": 0.2885714285714286,
          "uniqueID": "id-76348",
          "ioValues": [
            {
              "name": "assembly",
              "ioValue": "__GEOMETRY_INPUT__"
            }
          ],
          "interpreterVersion": 1,
          "code": "\n\n\nfunction run(assembly: Assembly) {\n  let faces: replicad.Face[] = []\n  assembly.onLeafs((leaf) => {\n    if (leaf.geometry instanceof replicad.Drawing) {\n      const sketches = leaf.geometry.sketchOnPlane(leaf.plane)\n      if (sketches instanceof replicad.Sketches) {\n        const t = sketches.faces()\n        faces = t instanceof replicad.Face ? [t] : t.faces\n      } else {\n        faces = [sketches.face()]\n      }\n    } else if (assembly.geometry instanceof replicad.Face) {\n      faces.push(assembly.geometry)\n    } else {\n      faces.push(...leaf.geometry.faces)\n    }\n    return leaf;\n  })\n\n  if (faces.length != 2) {\n    throw new Error(\"this function only supported for exactly two faces for now.\")\n  }\n\n  const w1 = replicad.assembleWire(faces[0].edges)\n  const w2 = replicad.assembleWire(faces[1].edges);\n  const boundary = replicad.loft([w2, w1], {}, true);\n  const solid = replicad.makeSolid([replicad.weldShellsAndFaces([...faces, boundary])]).simplify();\n\n  return solid;\n}",
          "compiledCode": "\"use strict\";\nfunction run(assembly) {\n    let faces = [];\n    assembly.onLeafs((leaf) => {\n        if (leaf.geometry instanceof replicad.Drawing) {\n            const sketches = leaf.geometry.sketchOnPlane(leaf.plane);\n            if (sketches instanceof replicad.Sketches) {\n                const t = sketches.faces();\n                faces = t instanceof replicad.Face ? [t] : t.faces;\n            }\n            else {\n                faces = [sketches.face()];\n            }\n        }\n        else if (assembly.geometry instanceof replicad.Face) {\n            faces.push(assembly.geometry);\n        }\n        else {\n            faces.push(...leaf.geometry.faces);\n        }\n        return leaf;\n    });\n    if (faces.length != 2) {\n        throw new Error(\"this function only supported for exactly two faces for now.\");\n    }\n    const w1 = replicad.assembleWire(faces[0].edges);\n    const w2 = replicad.assembleWire(faces[1].edges);\n    const boundary = replicad.loft([w2, w1], {}, true);\n    const solid = replicad.makeSolid([replicad.weldShellsAndFaces([...faces, boundary])]).simplify();\n    return solid;\n}\n"
        },
